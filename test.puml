@startuml
left to right direction

actor "一般ユーザー" as user
actor "管理者 (アドミン)" as admin
actor "外部システム" as api

rectangle 書籍管理システム_各種機能 {
    
    rectangle "レビュー管理" {
        usecase "書籍レビューを投稿する" as UC_PostReview
        usecase "レビュー一覧を見る" as UC_ViewReviews
        usecase "不適切なレビューを通報する" as UC_ReportReview
        usecase "不適切なレビューを削除する" as UC_DeleteReview
    }

    rectangle "書籍検索" {
        usecase "タイトル・キーワードで検索する" as UC_TitleSearch
        usecase "ジャンル別に検索する" as UC_GenreSearch
        usecase "著者別に検索する" as UC_AuthorSearch
        usecase "外部書籍情報（楽天API等）を検索する" as UC_ApiSearch
    }

    rectangle "発売日カレンダー" {
        usecase "続報日等を通知登録する" as UC_RegisterNotice
        usecase "通知一覧・カレンダーを表示する" as UC_ViewCalendar
        usecase "通知を削除する" as UC_DeleteNotice
        usecase "続報日を通知する" as UC_SendNotice
    }

    rectangle "購入リクエスト" {
        usecase "購入リクエストを送信する" as UC_SendRequest
        usecase "リクエストされた書籍一覧を見る" as UC_ViewRequests
    }

    rectangle "お問い合わせ" {
        usecase "問い合わせを入力・送信する" as UC_SendInquiry
        usecase "ユーザーからの問い合わせを閲覧する" as UC_ViewInquiry
    }

    ' アクターとユースケースの関連付け
    user -- UC_PostReview
    user -- UC_ViewReviews
    user -- UC_ReportReview
    
    user -- UC_TitleSearch
    user -- UC_GenreSearch
    user -- UC_AuthorSearch
    
    user -- UC_RegisterNotice
    user -- UC_ViewCalendar
    user -- UC_DeleteNotice
    
    user -- UC_SendRequest
    user -- UC_ViewRequests
    
    user -- UC_SendInquiry
    
    admin -- UC_DeleteReview
    admin -- UC_ViewInquiry

    ' システム・外部連携の関連付け
    api -- UC_ApiSearch
    api -- UC_SendNotice

    ' 包含・拡張関係
    UC_ReportReview .> UC_ViewReviews : <<extend>>
    UC_TitleSearch .> UC_ApiSearch : <<extend>>
}
@enduml