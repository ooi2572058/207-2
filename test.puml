@startuml test
skinparam classAttributeIconSize 0
skinparam style strictuml

package "アカウント領域" {
    class "ユーザー" as User {
        + ユーザーID
        + ユーザー名
        + メールアドレス
        + アカウント種別 (一般/法人/管理者)
        + アイコン画像
    }
}

package "書籍管理領域" {
    class "マスター書籍" as CatalogBook {
        + ISBNコード
        + タイトル
        + 著者名
        + ジャンル
        + 出版社
        + 発売日
    }

    class "蔵書" as PersonalBook {
        + 蔵書ID
        + 表紙写真
        + メモ (破損/不備/紛失等)
        + 登録日時
    }

    class "貸出記録" as Rental {
        + 貸出ID
        + 貸出日
        + 返却予定日
        + 返却日
        + 返却ステータス
    }
}

package "マーケット・EC領域" {
    class "出品商品" as ExhibitionItem {
        + 出品ID
        + 販売価格
        + 商品状態
        + 出品ステータス
    }

    class "公式商品" as OfficialProduct {
        + 商品ID
        + 商品名
        + 価格
        + 内容解説
        + 在庫数
    }

    class "カート" as Cart {
        + カートID
        + 合計金額
    }

    class "注文" as Order {
        + 注文ID
        + 注文日時
        + 合計決済金額
        + 発送ステータス
    }
}

package "コミュニティ・その他領域" {
    class "レビュー" as Review {
        + レビューID
        + 星評価 (1-5)
        + 感想コメント
        + 通報フラグ
    }

    class "メッセージ" as Message {
        + メッセージID
        + 本文
        + 送信日時
        + 既読フラグ
    }

    class "発売日通知" as ReleaseNotification {
        + 通知ID
        + 対象シリーズ名
        + 発売日
    }

    class "購入リクエスト" as PurchaseRequest {
        + リクエストID
        + 希望理由
        + 申請日時
    }

    class "お問い合わせ" as Inquiry {
        + 問い合わせID
        + カテゴリ
        + 本文
        + 対応ステータス
    }
}

' 関連定義 (Multiplicity)
User "1" -- "0..*" PersonalBook : 所有する >
PersonalBook "0..*" -- "1" CatalogBook : 元データ >
PersonalBook "1" -- "0..*" Rental : 貸出履歴 >
User "1" -- "0..*" Rental : 借りる >

User "1" -- "0..*" ExhibitionItem : 出品する >
PersonalBook "1" -- "0..1" ExhibitionItem : 対象蔵書 >

User "1" -- "1" Cart : 保持する >
User "1" -- "0..*" Order : 購入する >

User "1" -- "0..*" Review : 投稿する >
CatalogBook "1" -- "0..*" Review : 対象書籍 >

User "1 (送信者)" -- "0..*" Message : 送信する >
User "1 (受信者)" -- "0..*" Message : 受信する >

User "1" -- "0..*" ReleaseNotification : 登録する >
CatalogBook "1" -- "0..*" ReleaseNotification : 追跡対象 >

User "1" -- "0..*" PurchaseRequest : 申請する >
User "1" -- "0..*" Inquiry : 送信する >

@enduml